        "def sob():\n",
        "  !wget https://github.com/OlafenwaMoses/ImageAI/releases/download/3.0.0-pretrained/yolov3.pt\n",
        "\n",
        "  from imageai.Detection import ObjectDetection\n",
        "  from google.colab.patches import cv2_imshow\n",
        "  import cv2\n",
        "\n",
        "  !wget -O input_image.jpg https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTuFWrmVkApQfmbSgLwOuZciyiOsWByzUB2tUXuRtJoCw&s=10\n",
        "\n",
        "  detector = ObjectDetection()\n",
        "\n",
        "  model_path = \"/content/yolov3.pt\"\n",
        "\n",
        "  detector.setModelTypeAsYOLOv3()\n",
        "  detector.setModelPath(model_path)\n",
        "\n",
        "  detector.loadModel()\n",
        "\n",
        "  detections = detector.detectObjectsFromImage(\n",
        "    input_image=\"input_image.jpg\",\n",
        "    output_image_path=\"output_image.jpg\",\n",
        "    minimum_percentage_probability=30)\n",
        "\n",
        "\n",
        "  img = cv2.imread('output_image.jpg', cv2.IMREAD_UNCHANGED)\n",
        "  cv2_imshow(img)\n",
        "\n",
        "  print(\"Kaldırımı kullanın: Varsa her zaman yolun sağ tarafındaki kaldırımı tercih edin.\")\n",
        "  print(\"Sol kenardan yürüyün: Kaldırım olmayan yollarda, araçların sizi görebilmesi için yolun sol kenarından yürüyün.\")\n",
        "  print(\"Grup halinde yürüyün: Kalabalık gruplar halinde yürümeniz gerekirse tek sıra halinde hareket edin.\")\n",
        "\n"
      ],
